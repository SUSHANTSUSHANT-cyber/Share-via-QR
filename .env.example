APP_NAME=AISIN Secure File Transfer
APP_VERSION=0.2.0
HOST=0.0.0.0
PORT=9000
SERVER_URL=https://your-public-domain.example.com
DATABASE_PATH=database.db
SESSION_EXPIRY_MINUTES=1
MAX_FILE_SIZE_MB=200
ALLOWED_MIME_TYPES=application/pdf,application/octet-stream,video/mp4,video/quicktime,video/webm,video/x-msvideo,video/x-matroska
BLOCKED_EXTENSIONS=.exe,.bat,.cmd
CLEANUP_INTERVAL_MINUTES=30
GRAPH_CLIENT_ID=placeholder-client-id
GRAPH_CLIENT_SECRET=placeholder-client-secret
GRAPH_TENANT_ID=placeholder-tenant-id
SHAREPOINT_SITE_ID=placeholder-site-id
SHAREPOINT_DRIVE_ID=placeholder-drive-id
